# Copy to hippius.env (same folder) and fill in. Never commit the real file.
# 1) OWNER: Hippius console/app -> S3 Storage -> Create Master Token
OWNER_KEY=hip_...
OWNER_SECRET=...
# 2) SENDER: a Sub Token scoped ONLY to the "anchor" bucket the script creates
#    (run the script once with just OWNER_* filled; it prints the anchor bucket
#    name, then create the sub token scoped to it and fill these in)
SENDER_KEY=hip_...
SENDER_SECRET=...
